{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backendCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "engineVersion": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "backendCommit",
        "engineVersion"
      ]
    },
    "runKeys": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "expiry": {
          "type": "string",
          "pattern": "^([0-9]+(h|m|s))*[0-9]*[1-9][0-9]*(h|m|s)([0-9]+(h|m|s))*$"
        }
      }
    },
    "tenants": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "configMap": {
          "type": "string"
        },
        "key": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineClient": {
          "type": "string"
        },
        "clickhouse": {
          "type": "string"
        },
        "pushgateway": {
          "type": "string"
        },
        "prometheus": {
          "type": "string"
        },
        "audit": {
          "type": "string"
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "serverName": {
          "type": "string"
        },
        "jwtIssuer": {
          "type": "string"
        },
        "jwtAudience": {
          "type": "string"
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cluster": {
          "type": "string"
        }
      }
    },
    "bucket": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kmsKeyId": {
          "type": "string"
        }
      }
    },
    "pushgateway": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "instanceLabel": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_./:-]+$"
        },
        "exporters": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./:-]+$"
          }
        }
      }
    },
    "investigate": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issuer": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        },
        "audience": {
          "type": "string",
          "minLength": 1
        },
        "group": {
          "type": "string"
        },
        "auditEndpoint": {
          "type": "string",
          "pattern": "^(https://.+)?$"
        }
      }
    },
    "oncall": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string"
        }
      }
    },
    "marginSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "rounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hourly": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "budgetSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "startingDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "daily": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "hour": {
              "type": "integer",
              "minimum": 0,
              "maximum": 23
            },
            "minute": {
              "type": "integer",
              "minimum": 0,
              "maximum": 59
            },
            "budgetSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "startingDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "activeDeadlineSeconds": {
              "type": "integer",
              "minimum": 1
            },
            "resources": {
              "type": "object"
            }
          }
        }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hour": {
          "type": "integer",
          "minimum": 0,
          "maximum": 23
        },
        "minute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 59
        },
        "startingDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "investigation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object"
        }
      }
    },
    "reportsSizeLimit": {
      "type": "string",
      "minLength": 1
    },
    "serviceAccounts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "cleanup": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        },
        "investigate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dns": {
          "$ref": "#/definitions/rules"
        },
        "apiServer": {
          "$ref": "#/definitions/rules"
        },
        "engine": {
          "$ref": "#/definitions/rules"
        },
        "clickhouse": {
          "$ref": "#/definitions/rules"
        },
        "bucket": {
          "$ref": "#/definitions/rules"
        },
        "sts": {
          "$ref": "#/definitions/rules"
        },
        "prometheus": {
          "$ref": "#/definitions/rules"
        },
        "pushgateway": {
          "$ref": "#/definitions/rules"
        },
        "audit": {
          "$ref": "#/definitions/rules"
        },
        "idp": {
          "$ref": "#/definitions/rules"
        },
        "proxy": {
          "$ref": "#/definitions/rules"
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "noProxy": {
          "type": "string"
        }
      }
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deadline": {
          "type": "string",
          "pattern": "^(?:([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+)$",
          "not": {
            "pattern": "^([0.]+(ns|us|\u00b5s|ms|s|m|h))+$"
          }
        },
        "retry_wait": {
          "type": "string",
          "pattern": "^(?:([0-9]+(\\.[0-9]+)?(ns|us|\u00b5s|ms|s|m|h))+)$"
        },
        "concurrency": {
          "type": "integer",
          "minimum": 1
        },
        "max_pairs": {
          "type": "integer",
          "minimum": 1
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1
        },
        "windowed_above": {
          "type": "integer",
          "minimum": 0
        },
        "operations_limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "list_limit": {
          "type": "integer",
          "minimum": 1
        }
      },
      "dependencies": {
        "max_rows": [
          "windowed_above"
        ],
        "windowed_above": [
          "max_rows"
        ]
      }
    }
  },
  "definitions": {
    "selector": {
      "type": "object",
      "required": [
        "matchLabels"
      ],
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "peer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipBlock": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cidr"
          ],
          "properties": {
            "cidr": {
              "type": "string"
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "namespaceSelector": {
          "$ref": "#/definitions/selector"
        },
        "podSelector": {
          "$ref": "#/definitions/selector"
        }
      },
      "oneOf": [
        {
          "required": [
            "ipBlock"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "podSelector"
                ]
              },
              {
                "required": [
                  "namespaceSelector"
                ]
              }
            ]
          }
        },
        {
          "required": [
            "podSelector"
          ],
          "not": {
            "required": [
              "ipBlock"
            ]
          }
        }
      ]
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to",
          "ports"
        ],
        "properties": {
          "to": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/definitions/peer"
            }
          },
          "ports": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "port"
              ],
              "properties": {
                "protocol": {
                  "type": "string",
                  "enum": [
                    "TCP",
                    "UDP",
                    "SCTP"
                  ]
                },
                "port": {
                  "type": [
                    "integer",
                    "string"
                  ]
                },
                "endPort": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  }
}
